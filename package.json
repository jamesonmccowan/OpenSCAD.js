{
	"name": "openscad-js-studio",
	"version": "0.1.0",
	"description": "Independent partial OpenSCAD implementation with a browser studio, embeddable previews, Node API and CLI.",
	"author": "Jameson McCowan",
	"repository": { "type": "git", "url": "https://github.com/jamesonmccowan/openscad.js.git" },
	"homepage": "https://github.com/jamesonmccowan/openscad.js#readme",
	"bugs": { "url": "https://github.com/jamesonmccowan/openscad.js/issues" },
	"keywords": ["openscad", "cad", "csg", "webassembly", "3d"],
	"license": "Apache-2.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"import": "./src/index.js"
		},
		"./worker": "./src/core/worker-entry.js",
		"./viewer": {
			"types": "./src/viewer/viewer.d.ts",
			"import": "./src/viewer/viewer.js"
		},
		"./preview": {
			"types": "./src/preview/preview.d.ts",
			"import": "./src/preview/preview.js"
		},
		"./node": {
			"types": "./src/node/filesystem.d.ts",
			"import": "./src/node/filesystem.js"
		},
		"./node/fonts": {
			"types": "./src/node/fonts.d.ts",
			"import": "./src/node/fonts.js"
		}
	},
	"types": "./src/index.d.ts",
	"bin": {
		"openscad-js": "./bin/openscad-js.js"
	},
	"scripts": {
		"clean": "node scripts/clean.js",
		"release:check": "node scripts/release-check.js",
		"setup:reference": "bash scripts/build-reference.sh",
		"build": "node scripts/build-distribution.js",
		"build:editor": "node scripts/build-editor.js",
		"build:icon": "node scripts/build-icon.js",
		"pretest": "npm run build:editor",
		"pretest:viewer": "npm run build:editor",
		"pretest:browser": "npm run build",
		"test:distribution": "FORCE_COLOR=0 node --test tests/package-licenses.node.test.js tests/distribution.node.test.js && npm run test:browser -- tests/distribution.spec.js",
		"build:roof": "sh scripts/build-roof.sh && esbuild node_modules/straight-skeleton/dist/index.js --bundle --format=esm --platform=browser --minify --legal-comments=external --outfile=src/geometry/roof-straight-bundle.js",
		"test": "playwright test",
		"test:all": "npm run test:node && npm run test:browser && npm run test:types",
		"test:node": "FORCE_COLOR=0 node --test tests/*.node.test.js",
		"test:browser": "playwright test --workers=4",
		"test:types": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 src/index.d.ts src/viewer/viewer.d.ts src/preview/preview.d.ts src/node/filesystem.d.ts src/node/fonts.d.ts",
		"test:backend": "node --test tests/backend.node.test.js",
		"test:evaluator": "node --test tests/evaluator.node.test.js",
		"test:language-reference": "node --test tests/language-reference.node.test.js",
		"test:import": "node --test tests/import.node.test.js",
		"test:text-roof": "node --test tests/text-roof.node.test.js",
		"assess:models": "node scripts/assess-models.js",
		"measure:resources": "node --expose-gc scripts/measure-resources.js",
		"test:project": "node --test tests/project.node.test.js",
		"test:service": "node --test tests/service.node.test.js",
		"test:worker": "node --test tests/worker.node.test.js",
		"test:cli": "node --test tests/filesystem.node.test.js tests/cli.node.test.js",
		"test:viewer": "playwright test tests/viewer.spec.js",
		"test:studio-project": "node --test tests/studio-project.node.test.js",
		"cli": "node bin/openscad-js.js",
		"test:backend:browser": "playwright test tests/backend.spec.js"
	},
	"devDependencies": {
		"@playwright/test": "^1.55.0",
		"esbuild": "0.25.12",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/language": "6.13.1",
		"@codemirror/lint": "6.9.7",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.14",
		"@lezer/highlight": "1.2.5",
		"@fontsource/dm-mono": "5.3.0",
		"@fontsource/manrope": "5.3.0",
		"earcut": "3.0.2",
		"fflate": "0.8.3",
		"lucide": "0.468.0",
		"manifold-3d": "3.5.4",
		"opentype.js": "1.3.4",
		"straight-skeleton": "1.1.0",
		"three": "0.180.0"
	}
}
